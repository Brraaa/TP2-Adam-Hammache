@@ -0,0 +1,47 @@
+import type { Booking } from "../store.js";
+
+export type Result<T, E = string> = { ok: true; value: T } | { ok: false; error: E };
+
+export interface Slot {
+  startsAt: string;
+  endsAt: string;
+}
+
+const DAY_MS = 86400000;
+
+function toIso(ms: number): string {
+  return new Date(ms).toISOString().replace(".000Z", "Z");
+}
+
+// Une journee est [date 00:00 UTC, lendemain 00:00 UTC[, un creneau est [debut, fin[.
+export function freeSlots(
+  bookings: Pick<Booking, "startsAt" | "endsAt">[],
+  date: string
+): Result<Slot[]> {
+  const dayStart = /^\d{4}-\d{2}-\d{2}$/.test(date) ? Date.parse(`${date}T00:00:00Z`) : NaN;
+  // Le second test ecarte les dates que le moteur reporte au mois suivant (2026-02-30).
+  if (Number.isNaN(dayStart) || toIso(dayStart).slice(0, 10) !== date) {
+    return { ok: false, error: `date invalide, YYYY-MM-DD attendu : ${date}` };
+  }
+  const dayEnd = dayStart + DAY_MS;
+
+  const busy = bookings
+    .map((b) => ({ start: Date.parse(b.startsAt), end: Date.parse(b.endsAt) }))
+    .filter((b) => b.start < dayEnd && b.end > dayStart)
+    .sort((a, b) => a.start - b.start);
+
+  const slots: Slot[] = [];
+  let cursor = dayStart;
+  for (const b of busy) {
+    if (b.start > cursor) {
+      slots.push({ startsAt: toIso(cursor), endsAt: toIso(b.start) });
+    }
+    cursor = Math.max(cursor, b.end);
+  }
+  if (cursor < dayEnd) {
+    slots.push({ startsAt: toIso(cursor), endsAt: toIso(dayEnd) });
+  }
+  return { ok: true, value: slots };
+}
+
+export default freeSlots;
