 import { Router } from "express";
 import { rooms, findRoom, bookingsForRoom } from "../store.js";
+import freeSlots from "../lib/availability.js";
 
 export const roomsRouter = Router();
 
@@ -15,3 +16,22 @@ roomsRouter.get("/:id", (req, res) => {
   }
   res.json({ room, bookings: bookingsForRoom(room.id) });
 });
+
+roomsRouter.get("/:id/availability", (req, res) => {
+  const room = findRoom(req.params.id);
+  if (!room) {
+    res.status(404).json({ error: "salle inconnue" });
+    return;
+  }
+  const date = req.query.date;
+  if (typeof date !== "string") {
+    res.status(400).json({ error: "parametre manquant : date" });
+    return;
+  }
+  const slots = freeSlots(bookingsForRoom(room.id), date);
+  if (slots.ok === false) {
+    res.status(400).json({ error: slots.error });
+    return;
+  }
+  res.json({ roomId: room.id, date, slots: slots.value });
+});
diff --git a/test/availability.spec.ts b/test/availability.spec.ts
new file mode 100644
index 0000000..a544cbd
--- /dev/null
+++ b/test/availability.spec.ts
@@ -0,0 +1,156 @@
+import { describe, it, expect } from "vitest";
+import { createApp } from "../src/app.js";
+import freeSlots from "../src/lib/availability.js";
+
+async function call(path: string) {
+  const app = createApp();
+  const server = app.listen(0);
+  const { port } = server.address() as { port: number };
+  try {
+    const res = await fetch(`http://127.0.0.1:${port}${path}`);
+    return { status: res.status, body: (await res.json()) as any };
+  } finally {
+    server.close();
+  }
+}
+
+const slot = (startsAt: string, endsAt: string) => ({ startsAt, endsAt });
+
+describe("freeSlots", () => {
+  it("rend la journee entiere quand rien n'est reserve", () => {
+    expect(freeSlots([], "2026-10-05")).toEqual({
+      ok: true,
+      value: [slot("2026-10-05T00:00:00Z", "2026-10-06T00:00:00Z")]
+    });
+  });
+
+  it("decoupe la journee autour des reservations, meme non triees", () => {
+    const result = freeSlots(
+      [
+        slot("2026-10-05T14:00:00Z", "2026-10-05T15:30:00Z"),
+        slot("2026-10-05T09:00:00Z", "2026-10-05T11:00:00Z")
+      ],
+      "2026-10-05"
+    );
+    expect(result).toEqual({
+      ok: true,
+      value: [
+        slot("2026-10-05T00:00:00Z", "2026-10-05T09:00:00Z"),
+        slot("2026-10-05T11:00:00Z", "2026-10-05T14:00:00Z"),
+        slot("2026-10-05T15:30:00Z", "2026-10-06T00:00:00Z")
+      ]
+    });
+  });
+
+  it("ne cree pas de creneau vide entre deux reservations bout a bout", () => {
+    const result = freeSlots(
+      [
+        slot("2026-10-05T09:00:00Z", "2026-10-05T10:00:00Z"),
+        slot("2026-10-05T10:00:00Z", "2026-10-05T11:00:00Z")
+      ],
+      "2026-10-05"
+    );
+    expect(result).toEqual({
+      ok: true,
+      value: [
+        slot("2026-10-05T00:00:00Z", "2026-10-05T09:00:00Z"),
+        slot("2026-10-05T11:00:00Z", "2026-10-06T00:00:00Z")
+      ]
+    });
+  });
+
+  it("fusionne les reservations qui se recouvrent", () => {
+    const result = freeSlots(
+      [
+        slot("2026-10-05T09:00:00Z", "2026-10-05T12:00:00Z"),
+        slot("2026-10-05T10:00:00Z", "2026-10-05T11:00:00Z")
+      ],
+      "2026-10-05"
+    );
+    expect(result).toEqual({
+      ok: true,
+      value: [
+        slot("2026-10-05T00:00:00Z", "2026-10-05T09:00:00Z"),
+        slot("2026-10-05T12:00:00Z", "2026-10-06T00:00:00Z")
+      ]
+    });
+  });
+
+  it("borne a la journee les reservations qui debordent sur la veille ou le lendemain", () => {
+    const result = freeSlots(
+      [
+        slot("2026-10-04T22:00:00Z", "2026-10-05T02:00:00Z"),
+        slot("2026-10-05T23:00:00Z", "2026-10-06T01:00:00Z")
+      ],
+      "2026-10-05"
+    );
+    expect(result).toEqual({
+      ok: true,
+      value: [slot("2026-10-05T02:00:00Z", "2026-10-05T23:00:00Z")]
+    });
+  });
+
+  it("ignore les reservations des autres jours, y compris celles qui touchent minuit", () => {
+    const result = freeSlots(
+      [
+        slot("2026-10-04T22:00:00Z", "2026-10-05T00:00:00Z"),
+        slot("2026-10-06T00:00:00Z", "2026-10-06T02:00:00Z")
+      ],
+      "2026-10-05"
+    );
+    expect(result).toEqual({
+      ok: true,
+      value: [slot("2026-10-05T00:00:00Z", "2026-10-06T00:00:00Z")]
+    });
+  });
+
+  it("ne rend aucun creneau quand la journee est entierement reservee", () => {
+    const result = freeSlots([slot("2026-10-04T12:00:00Z", "2026-10-06T12:00:00Z")], "2026-10-05");
+    expect(result).toEqual({ ok: true, value: [] });
+  });
+
+  it.each(["05/10/2026", "2026-10-5", "2026-13-01", "2026-02-30", "2026-10-05T09:00:00Z", ""])(
+    "refuse la date %j sans lever d'exception",
+    (date) => {
+      const result = freeSlots([], date);
+      expect(result.ok).toBe(false);
+    }
+  );
+});
+
+describe("GET /rooms/:id/availability", () => {
+  it("renvoie les creneaux libres autour de la reservation existante", async () => {
+    const res = await call("/rooms/salle-a/availability?date=2026-10-05");
+    expect(res.status).toBe(200);
+    expect(res.body).toEqual({
+      roomId: "salle-a",
+      date: "2026-10-05",
+      slots: [
+        slot("2026-10-05T00:00:00Z", "2026-10-05T09:00:00Z"),
+        slot("2026-10-05T11:00:00Z", "2026-10-06T00:00:00Z")
+      ]
+    });
+  });
+
+  it("ne tient pas compte des reservations des autres salles", async () => {
+    const res = await call("/rooms/salle-b/availability?date=2026-10-05");
+    expect(res.status).toBe(200);
+    expect(res.body.slots).toEqual([slot("2026-10-05T00:00:00Z", "2026-10-06T00:00:00Z")]);
+  });
+
+  it("repond 404 pour une salle inconnue", async () => {
+    const res = await call("/rooms/cave/availability?date=2026-10-05");
+    expect(res.status).toBe(404);
+  });
+
+  it("repond 400 quand la date manque", async () => {
+    const res = await call("/rooms/salle-a/availability");
+    expect(res.status).toBe(400);
+  });
+
+  it("repond 400 pour une date mal formee", async () => {
+    const res = await call("/rooms/salle-a/availability?date=demain");
+    expect(res.status).toBe(400);
+    expect(res.body.error).toContain("date invalide");
+  });
+});
