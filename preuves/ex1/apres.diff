+// Jour calendaire UTC, pour designer une journee entiere plutot qu'un instant.
+const DAY = /^\d{4}-\d{2}-\d{2}$/;
+
+export function requireDay(payload: Record<string, unknown>, field: string): string {
+  const value = requireString(payload, field);
+  const parsed = DAY.test(value) ? Date.parse(`${value}T00:00:00Z`) : NaN;
+  // L'aller-retour ecarte les jours que Date.parse reporte au mois suivant (2026-02-30).
+  if (Number.isNaN(parsed) || new Date(parsed).toISOString().slice(0, 10) !== value) {
+    throw new ValidationError(`jour invalide : ${field} (attendu YYYY-MM-DD)`);
+  }
+  return value;
+}
