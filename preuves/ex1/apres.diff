diff --git a/test/availability.spec.ts b/test/availability.spec.ts
new file mode 100644
index 0000000..e63e15a
--- /dev/null
+++ b/test/availability.spec.ts
@@ -0,0 +1,105 @@
+import { describe, it, expect } from "vitest";
+import { dayBounds, freeSlots } from "../src/lib/availability.js";
+
+const day = { startsAt: "2026-10-05T00:00:00Z", endsAt: "2026-10-06T00:00:00Z" };
+
+describe("dayBounds", () => {
+  it("va de minuit a minuit du lendemain, en UTC", () => {
+    expect(dayBounds("2026-10-05")).toEqual(day);
+  });
+
+  it("passe la fin de mois et la fin d'annee", () => {
+    expect(dayBounds("2026-12-31")).toEqual({
+      startsAt: "2026-12-31T00:00:00Z",
+      endsAt: "2027-01-01T00:00:00Z"
+    });
+  });
+
+  it("passe le 29 fevrier d'une annee bissextile", () => {
+    expect(dayBounds("2028-02-28").endsAt).toBe("2028-02-29T00:00:00Z");
+  });
+});
+
+describe("freeSlots", () => {
+  it("renvoie la fenetre entiere quand rien n'est reserve", () => {
+    expect(freeSlots(day, [])).toEqual([day]);
+  });
+
+  it("decoupe la fenetre autour d'une reservation", () => {
+    expect(freeSlots(day, [{ startsAt: "2026-10-05T09:00:00Z", endsAt: "2026-10-05T11:00:00Z" }])).toEqual([
+      { startsAt: "2026-10-05T00:00:00Z", endsAt: "2026-10-05T09:00:00Z" },
+      { startsAt: "2026-10-05T11:00:00Z", endsAt: "2026-10-06T00:00:00Z" }
+    ]);
+  });
+
+  it("trie les reservations avant de decouper", () => {
+    expect(
+      freeSlots(day, [
+        { startsAt: "2026-10-05T14:00:00Z", endsAt: "2026-10-05T15:00:00Z" },
+        { startsAt: "2026-10-05T09:00:00Z", endsAt: "2026-10-05T10:00:00Z" }
+      ])
+    ).toEqual([
+      { startsAt: "2026-10-05T00:00:00Z", endsAt: "2026-10-05T09:00:00Z" },
+      { startsAt: "2026-10-05T10:00:00Z", endsAt: "2026-10-05T14:00:00Z" },
+      { startsAt: "2026-10-05T15:00:00Z", endsAt: "2026-10-06T00:00:00Z" }
+    ]);
+  });
+
+  it("ne cree pas de creneau vide entre deux reservations bout a bout", () => {
+    expect(
+      freeSlots(day, [
+        { startsAt: "2026-10-05T09:00:00Z", endsAt: "2026-10-05T10:00:00Z" },
+        { startsAt: "2026-10-05T10:00:00Z", endsAt: "2026-10-05T11:00:00Z" }
+      ])
+    ).toEqual([
+      { startsAt: "2026-10-05T00:00:00Z", endsAt: "2026-10-05T09:00:00Z" },
+      { startsAt: "2026-10-05T11:00:00Z", endsAt: "2026-10-06T00:00:00Z" }
+    ]);
+  });
+
+  it("fusionne des reservations qui se recouvrent ou s'emboitent", () => {
+    expect(
+      freeSlots(day, [
+        { startsAt: "2026-10-05T09:00:00Z", endsAt: "2026-10-05T13:00:00Z" },
+        { startsAt: "2026-10-05T10:00:00Z", endsAt: "2026-10-05T11:00:00Z" },
+        { startsAt: "2026-10-05T12:00:00Z", endsAt: "2026-10-05T14:00:00Z" }
+      ])
+    ).toEqual([
+      { startsAt: "2026-10-05T00:00:00Z", endsAt: "2026-10-05T09:00:00Z" },
+      { startsAt: "2026-10-05T14:00:00Z", endsAt: "2026-10-06T00:00:00Z" }
+    ]);
+  });
+
+  it("rogne les reservations qui debordent de la fenetre", () => {
+    expect(
+      freeSlots(day, [
+        { startsAt: "2026-10-04T22:00:00Z", endsAt: "2026-10-05T02:00:00Z" },
+        { startsAt: "2026-10-05T23:00:00Z", endsAt: "2026-10-06T01:00:00Z" }
+      ])
+    ).toEqual([{ startsAt: "2026-10-05T02:00:00Z", endsAt: "2026-10-05T23:00:00Z" }]);
+  });
+
+  it("ignore les reservations hors fenetre, y compris celles qui la touchent", () => {
+    expect(
+      freeSlots(day, [
+        { startsAt: "2026-10-04T22:00:00Z", endsAt: "2026-10-05T00:00:00Z" },
+        { startsAt: "2026-10-06T00:00:00Z", endsAt: "2026-10-06T01:00:00Z" },
+        { startsAt: "2026-10-08T09:00:00Z", endsAt: "2026-10-08T10:00:00Z" }
+      ])
+    ).toEqual([day]);
+  });
+
+  it("ne renvoie rien quand la fenetre est entierement reservee", () => {
+    expect(freeSlots(day, [day])).toEqual([]);
+    expect(freeSlots(day, [{ startsAt: "2026-10-04T12:00:00Z", endsAt: "2026-10-06T12:00:00Z" }])).toEqual([]);
+  });
+
+  it("ne modifie pas la liste recue", () => {
+    const busy = [
+      { startsAt: "2026-10-05T14:00:00Z", endsAt: "2026-10-05T15:00:00Z" },
+      { startsAt: "2026-10-05T09:00:00Z", endsAt: "2026-10-05T10:00:00Z" }
+    ];
+    freeSlots(day, busy);
+    expect(busy[0].startsAt).toBe("2026-10-05T14:00:00Z");
+  });
+});
