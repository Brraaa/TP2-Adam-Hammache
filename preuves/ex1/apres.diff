@@ -0,0 +1,43 @@
+export interface Slot {
+  startsAt: string;
+  endsAt: string;
+}
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+
+/**
+ * Bornes UTC d'une journee `YYYY-MM-DD` : [minuit, minuit du lendemain[.
+ */
+export function dayBounds(day: string): Slot {
+  const startsAt = `${day}T00:00:00Z`;
+  const endsAt = new Date(Date.parse(startsAt) + DAY_MS).toISOString().replace(".000Z", "Z");
+  return { startsAt, endsAt };
+}
+
+/**
+ * Creneaux libres de la fenetre une fois retires les creneaux occupes.
+ *
+ * Les creneaux sont [debut, fin[ : un creneau libre peut commencer a l'instant ou une
+ * reservation se termine. Les creneaux occupes qui debordent de la fenetre sont rognes.
+ */
+export function freeSlots(window: Slot, busy: Slot[]): Slot[] {
+  const windowEnd = Date.parse(window.endsAt);
+  const sorted = busy
+    .filter((b) => Date.parse(b.endsAt) > Date.parse(window.startsAt) && Date.parse(b.startsAt) < windowEnd)
+    .sort((a, b) => Date.parse(a.startsAt) - Date.parse(b.startsAt));
+
+  const free: Slot[] = [];
+  let cursor = window.startsAt;
+  for (const b of sorted) {
+    if (Date.parse(b.startsAt) > Date.parse(cursor)) {
+      free.push({ startsAt: cursor, endsAt: b.startsAt });
+    }
+    if (Date.parse(b.endsAt) > Date.parse(cursor)) {
+      cursor = b.endsAt;
+    }
+  }
+  if (Date.parse(cursor) < windowEnd) {
+    free.push({ startsAt: cursor, endsAt: window.endsAt });
+  }
+  return free;
+}
